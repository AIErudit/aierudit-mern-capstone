# AIErudit Bookshop — local environment template
# Copy to .env and fill in the values. Never commit .env.

# Express server
NODE_ENV=development
PORT=5000

# MongoDB connection (local Mongo, MongoDB Atlas, or docker-compose service)
# Default for local dev with docker-compose: mongodb://localhost:27017/aierudit_bookshop
MONGO_URI=mongodb://localhost:27017/aierudit_bookshop

# JWT
# Generate any 32+ char random string. Example: openssl rand -base64 48
JWT_SECRET=replace-this-with-a-real-secret-before-running
JWT_EXPIRES_IN=7d

# Cookie config
COOKIE_NAME=aerd_session

# Payment mock (the capstone does not call a real payment provider)
PAYMENT_MOCK_DELAY_MS=300
